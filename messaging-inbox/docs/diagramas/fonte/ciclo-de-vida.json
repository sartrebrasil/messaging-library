  "cards": [
    {
      "dot": "cyan",
      "title": "Ordem dos níveis",
      "items": [
        "Nível 1: em memória, no mesmo worker",
        "Nível 2: com atraso, estratégia escolhida pelas capabilities",
        "Nível 3: passada lenta na DLQ comum, só com dead-letter",
        "RetryAfter e skip-immediate pulam o nível 1"
      ]
    },
    {
      "dot": "rose",
      "title": "Fim definitivo",
      "items": [
        "failed é obrigatória em todo receiver",
        "Cópias levam o corpo original e inbox_failure",
        "Cópia sempre antes do ack: duplicata, nunca perda"
      ]
    },
    {
      "dot": "amber",
      "title": "Volta ao início",
      "items": [
        "Reentrega do nível 2 e release voltam à fila principal",
        "Passada do nível 3 reprocessa na própria DLQ; quem falha volta ao fim dela",
        "Redrive (API ou Actuator) zera as tentativas"
      ]
    }
